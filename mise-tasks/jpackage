#!/usr/bin/env bash
#MISE description="Build a self-contained native installer for the host platform with jpackage"
#MISE raw=true
#
# usage: mise run jpackage <version> <variant> [export-dir]
#
# Wraps a Processing export (jars + native libs + data/) into a native, fully
# self-contained application, embedding a minimal runtime that jpackage links for
# us. No Java needed on the user's machine.
#
#   macOS    .dmg
#   Windows  .msi
#   Linux    .deb and .rpm
#
# jpackage cannot cross-compile - it drives the OS's own packaging tools - so this
# only ever builds for the machine it runs on. The release workflow therefore runs
# it once per platform, on top of exports produced by a single Linux job.
#
# Modules come from `jdeps --print-module-deps` over the exported jars, plus
# jdk.unsupported for JOGL's sun.misc.Unsafe use.

set -eu

cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

VERSION=${1:?usage: jpackage <version> <variant> [export-dir]}
VARIANT=${2:?usage: jpackage <version> <variant> [export-dir]}
SRC=${3:-build/$VARIANT}

OUT=dist
MODULES=java.base,java.desktop,java.management,java.scripting,java.sql,jdk.unsupported

[ -d "$SRC" ] || { echo "jpackage: no export at $SRC (run ./build.sh export $VARIANT)" >&2; exit 1; }

# Installers reject non-numeric versions, so an RC ships as its numeric base
# (0.4.0-rc.1 -> 0.4.0). The full version always stays in the file name.
APP_VERSION=${VERSION%%-*}

mkdir -p "$OUT"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# jpackage takes a single --input directory, but the exports differ per platform:
# macOS keeps jars, native libs and data/ together inside the .app, while Linux and
# Windows split them into lib/ and data/. Stage one directory so data/ always ends
# up beside the jars, which is where Processing looks for it at run time.
STAGE=$WORK/input
mkdir -p "$STAGE"
if [ -d "$SRC/petscii.app/Contents/Java" ]; then
    cp -R "$SRC/petscii.app/Contents/Java/." "$STAGE/"
else
    cp -R "$SRC/lib/." "$STAGE/"
    [ -d "$SRC/data" ] && cp -R "$SRC/data" "$STAGE/"
fi
[ -f "$STAGE/petscii.jar" ] || { echo "jpackage: petscii.jar not found in $SRC" >&2; exit 1; }

# data/ must sit beside the jars: Processing resolves it from the jar directory,
# and without it the charset never loads and the sketch dies in initrender().
[ -d "$STAGE/data" ] || { echo "jpackage: data/ missing from the staged input ($SRC)" >&2; exit 1; }
echo ">> staged input:"
ls -1 "$STAGE" | sed 's/^/   /'

# Licence and build provenance. --copyright is what the macOS About panel prints
# under the version (NSHumanReadableCopyright), and the same string is kept in the
# Windows and Linux package metadata, so any build states its licence and can be
# traced back to a commit - the "-dirty" suffix included, when one was cut from a
# modified tree.
COMMIT=$(git describe --always --tags --dirty 2>/dev/null || echo unknown)
BUILT=$(date -u +"%Y-%m-%d %H:%M UTC")
echo ">> build: $COMMIT, built $BUILT"

HOST=$(uname -s)

# macOS bundles cannot carry a leading-zero version (a CFBundleVersion rule that
# jpackage enforces for every bundle type), so a 0.x project gets 1.0.0 inside the
# bundle only. Nothing surfaces it - petscii displays no version anywhere - and the
# file name still carries the real one. Remove this once the project hits 1.0.0.
case "$HOST:$APP_VERSION" in
    Darwin:0.*|Darwin:0) APP_VERSION=1.0.0 ;;
esac

# NOTE on Windows upgrades: the installer version is deliberately the plain
# numeric base (0.3.1-rc.3 -> 0.3.1), never an encoded one. Windows compares only
# major.minor.build, so it is tempting to fold the RC number into the build field -
# but that poisons the ordering forever: a later, genuine 0.3.2 would compare as
# OLDER than an encoded 0.3.103 and refuse to install.
#
# The consequence is that consecutive RCs of the same patch share a ProductVersion
# and Windows will not upgrade one onto another ("another version is already
# installed"). Stable releases are unaffected, since their versions increase
# naturally. Uninstall the previous RC first - see "Known issues" in the README.

# Common arguments. $APPDIR is expanded by the generated launcher at run time and
# is where --input contents land, so the JOGL natives beside the jars are found.
#
# -Duser.dir is what makes data/ resolvable. Processing only special-cases macOS
# .app bundles when locating the sketch folder; everywhere else it falls back to
# the working directory, and a jpackage launcher inherits whatever directory the
# user happened to be in (the home directory, from a Start Menu shortcut). Without
# this the charset never loads and the sketch dies with a NullPointerException in
# Charset.initrender().
set -- --name petscii \
       --app-version "$APP_VERSION" \
       --input "$STAGE" \
       --main-jar petscii.jar \
       --main-class petscii \
       --add-modules "$MODULES" \
       --java-options '-Djna.nosys=true' \
       --java-options '-Djava.library.path=$APPDIR' \
       --java-options '-Duser.dir=$APPDIR' \
       --jlink-options '--strip-debug --no-man-pages --no-header-files' \
       --vendor "Vent/EXT" \
       --copyright "WTFPL v2. $COMMIT, built $BUILT" \
       --description "Marq's PETSCII editor (Vent's fork) $VERSION ($COMMIT, built $BUILT)" \
       --dest "$WORK"

# Each platform wants its own icon format. All three are generated from the single
# 128x128 source extras/petscii.png with nearest-neighbour scaling, so the pixel art
# stays sharp at every integer size:
#
#   for each size: magick extras/petscii.png -filter point -resize NxN ...
#   iconutil -c icns petscii.iconset -o extras/petscii.icns     (macOS)
#   magick ... -delete 0 extras/petscii.ico                     (Windows)
#
# Missing an icon is not fatal - jpackage falls back to a generic Java icon - but it
# is reported, because a silently unbranded build is easy to ship by accident.
ICONS=$PWD/extras
icon=""
case "$HOST" in
    Darwin)
        TYPES="dmg"
        icon="$ICONS/petscii.icns"
        ;;
    Linux)
        # Both Debian and RPM come straight from jpackage, so no alien conversion
        TYPES="deb rpm"
        icon="$ICONS/petscii.png"
        set -- "$@" --linux-shortcut --linux-menu-group Graphics
        ;;
    MINGW* | MSYS* | CYGWIN*)
        TYPES="msi"
        icon="$ICONS/petscii.ico"
        set -- "$@" --win-menu --win-shortcut --win-menu-group Graphics
        ;;
    *)
        echo "jpackage: unsupported host $(uname -s)" >&2
        exit 1
        ;;
esac

if [ -f "$icon" ]; then
    set -- "$@" --icon "$icon"
    echo ">> icon: $icon"
else
    echo ">> WARNING: no icon at $icon; the build will use the generic Java icon" >&2
fi

if [ "$HOST" = "Darwin" ]; then
    # Two steps on macOS so the bundle can advertise the real version. --app-version
    # only accepts one to three integers, so the app image is built with the numeric
    # substitute and CFBundleShortVersionString is then set to the true version -
    # that is the string Finder's Get Info and the About panel display. The dmg is
    # wrapped around the patched image afterwards.
    echo ">> jpackage --type app-image ($VARIANT)"
    jpackage --type app-image "$@"
    app="$WORK/petscii.app"
    [ -d "$app" ] || { echo "jpackage: no app image at $app" >&2; exit 1; }
    /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $VERSION" "$app/Contents/Info.plist"
    echo ">> bundle version: $(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$app/Contents/Info.plist")"

    # The dmg is assembled with hdiutil rather than "jpackage --type dmg
    # --app-image", because that step rewrites Info.plist and would put the numeric
    # substitute back, undoing the patch above. This also lets the mounted volume
    # carry the exact version, and keeps the familiar drag-to-Applications layout.
    root=$WORK/dmgroot
    mkdir -p "$root"
    cp -R "$app" "$root/"
    ln -s /Applications "$root/Applications"
    echo ">> hdiutil: building dmg ($VARIANT)"
    hdiutil create -volname "petscii $VERSION" -srcfolder "$root" \
        -ov -quiet -format UDZO "$WORK/petscii.dmg"
    rm -rf "$app" "$root"
else
    for type in $TYPES; do
        echo ">> jpackage --type $type ($VARIANT)"
        jpackage --type "$type" "$@"
    done
fi

# jpackage names files after the app and numeric version only; rename so the
# variant and the real version (including any -rc.N) are visible in the release.
for f in "$WORK"/*; do
    [ -f "$f" ] || continue
    ext=${f##*.}
    mv "$f" "$OUT/petscii-$VERSION-$VARIANT.$ext"
    echo ">> $OUT/petscii-$VERSION-$VARIANT.$ext"
done
